{
	"folders":
	[
		{
			"path": ".",
		}
	],
	"settings":
	{
		"LSP":
		{
			"odin":
			{
				"enabled": true,
			},
		},
	},
	"build_systems":
	[
		{
			"name": "Odin - Run Debug",
			"selector": "source.odin",
			"working_dir": "${project_path}",
			"file_regex": "^(.+)\\(([0-9]+):([0-9]+)\\) (.+)$",
			"windows": {
				"cmd": ["python3.exe", "${project_path}\\build.py", "run"],
			},
			"linux": {
				"cmd": ["./build.py", "run"],
			},
		},
		{
			"name": "Odin - Build Debug",
			"selector": "source.odin",
			"working_dir": "${project_path}",
			"file_regex": "^(.+)\\(([0-9]+):([0-9]+)\\) (.+)$",
			"windows": {
				"cmd": ["python3.exe", "${project_path}\\build.py", "compile"],
			},
			"linux": {
				"cmd": ["./build.py", "compile"],
			},
		},
	],
	"debugger_configurations":
	[
		{
			"name": "Launch Compiled Binary",
			"type": "lldb",
			"request": "launch",
			"cwd": "${project_path}",
			"terminal": "console",
			"windows": {
				"program": "${project_path}/bin/monokl.exe"
			},
			"linux": {
				"program": "${project_path}/bin/monokl"
			}
		}
	],
}
